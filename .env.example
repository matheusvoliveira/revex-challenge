POSTGRES_DB=revex
POSTGRES_USER=revex
POSTGRES_PASSWORD=revex
# Compose usa o hostname do serviço: jdbc:postgresql://db:5432/revex
# Dev local (mvn / Vite) só se o Postgres estiver publicado em localhost:5432
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/revex
SPRING_DATASOURCE_USERNAME=revex
SPRING_DATASOURCE_PASSWORD=revex
JWT_SECRET=local-dev-only-secret-min-32-bytes-ok
JWT_EXPIRATION_SECONDS=28800
# Seed de demonstração (Flyway V3): username=revex password=revex (só o hash BCrypt fica no banco)
